rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /tournaments/{tournamentId} {
      allow read: if isValidId(tournamentId);
      allow create, update: if isValidId(tournamentId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.players is list
        && request.resource.data.matches is list;
      allow delete: if isValidId(tournamentId);
    }
  }
}
